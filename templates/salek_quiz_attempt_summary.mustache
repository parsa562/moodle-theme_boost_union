{{!
    @template theme_boost_union/salek_quiz_attempt_summary

    Salek: the summary of a quiz attempt (as mod_quiz/attempt_summary_information), each row with
    its name as a class (from theme_boost_union\output\mod_quiz_renderer).

    Example context (json):
    {
        "items": [
            {"class": "salek-qs-state salek-qs-state-finished", "title": "Status", "content": "Finished"},
            {"class": "salek-qs-startedon", "title": "Started", "content": "Thursday, 23 November 2023, 9:29 AM"},
            {"class": "salek-qs-grade", "title": "Grade", "content": "Not yet graded"}
        ],
        "caption": "Summary of attempt"
    }
}}
<table class="table generaltable generalbox quizreviewsummary salek-quiz-summary mb-0">
    {{#caption}}
        <caption class="visually-hidden">{{caption}}</caption>
    {{/caption}}
    <tbody>
    {{#items}}
        <tr class="{{class}}">
            <th class="cell" scope="row">{{{title}}}</th>
            <td class="cell">{{{content}}}</td>
        </tr>
    {{/items}}
    </tbody>
</table>
