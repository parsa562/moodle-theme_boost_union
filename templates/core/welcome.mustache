{{!
    @template core/welcome

    Salek: the welcome on the Dashboard after logging in: today's date small and quiet, Moodle's
    welcome ("Hi, …! 👋") large and bold, a short line about the page under it. (Moodle: the
    welcome only.)

    Example context (json):
    {
        "welcomemessage": "Hi, Admin! 👋",
        "salekwelcomedate": "Tuesday, 19 Aban"
    }
}}
{{#welcomemessage}}
<div class="salek-welcome">
    {{#salekwelcomedate}}
    <div class="salek-welcome-date">{{.}}</div>
    {{/salekwelcomedate}}
    <div class="salek-welcome-title">{{welcomemessage}}</div>
    <p class="salek-welcome-sub">{{#str}}salekwelcomesub, theme_boost_union{{/str}}</p>
</div>
{{/welcomemessage}}
