{{!
    @template theme_boost_union/courselistingcard

    This template renders a card for the course listing.
    This is a modified version of core_course/coursecard and is used to show the course cards on site home and the category.
    In addition to that it contains the partials from block_myoverview/view-cards.

    Example context (json):
    {
        "courses": [
            {
                "name": "Assignment due 1",
                "viewurl": "https://moodlesite/course/view.php?id=2",
                "courseimage": "https://moodlesite/pluginfile/123/course/overviewfiles/123.jpg",
                "fullname": "course 3",
                "hasprogress": true,
                "progress": 10,
                "progressstyleasbar": false,
                "visible": true
            }
        ]
    }
}}
<div class="card course-card mx-2 mb-3" role="listitem"
    data-region="course-content"
    data-course-id="{{{id}}}"
    data-startdate="{{startdate}}">
    {{#showcourseimage}}
    <a href="{{viewurl}}" tabindex="-1">
        <div class="card-img-top" style='background-image: url("{{{courseimage}}}");'>
            <span class="visually-hidden">{{fullname}}</span>
        </div>
    </a>
    {{/showcourseimage}}
    <div class="card-body course-info-container px-3" id="course-info-container-{{id}}">
        <div class="d-flex align-items-start">
            <div class="w-100">
                {{#showshortname}}
                    <div class="course-card-shortname text-muted muted d-flex flex-wrap">
                        <span class="visually-hidden">
                            {{#str}}aria:courseshortname, core_course{{/str}}
                        </span>
                        <div class="text-truncate small">
                            <span class="shortname">
                                {{{shortname}}}
                            </span>
                        </div>
                    </div>
                {{/showshortname}}
                <a href="{{viewurl}}" class="aalink coursename">
                    <span class="visually-hidden">
                        {{#str}}aria:coursename, core_course{{/str}}
                    </span>
                    {{{fullname}}}
                </a>
                {{! (No category on the cards: the site's categories are for its own organisation.) }}

                {{#hassummary}}
                    <div class="course-card-summary" data-course-summary>
                        <div class="course-card-summary-content" data-course-summary-content>
                            {{{summary}}}
                        </div>

                        <button type="button"
                                class="course-card-summary-toggle"
                                data-course-summary-toggle
                                aria-expanded="false">
                            <span class="summary-more">{{#str}}coursecardmore, theme_boost_union{{/str}}</span>
                            <span class="summary-less">{{#str}}coursecardless, theme_boost_union{{/str}}</span>
                        </button>
                    </div>
                {{/hassummary}}


                {{#showcoursefields}}
                    {{#hascustomfields}}
                        <div class="course-card-fields">
                            <div class="customfields">
                                {{{customfields}}}
                            </div>
                        </div>
                    {{/hascustomfields}}
                {{/showcoursefields}}
                {{^visible}}
                    <div class="d-flex flex-wrap">
                        <span class="badge bg-info text-white">{{#str}} hiddenfromstudents {{/str}}</span>
                    </div>
                {{/visible}}
            </div>
        </div>
    </div>

    {{#showdetailsbar}}
        <div class="d-flex align-items-start mt-0 mb-2">
            {{#showcourseprogress}}
                {{#hasprogress}}
                    <div class="border-0 px-3 border-radius w-100">
                        {{#progressstyleasbar}}
                            {{> theme_boost_union/course-progress-with-bar}}
                        {{/progressstyleasbar}}
                        {{^progressstyleasbar}}
                            {{> theme_boost_union/course-progress-without-bar}}
                        {{/progressstyleasbar}}
                    </div>
                {{/hasprogress}}
            {{/showcourseprogress}}
            {{#showcourseenrolicons}}
                {{#hasenrolicons}}
                    <div class="menu border-0 pe-3 ms-auto">
                        <div class="enrolmenticons d-flex">
                            {{#enrolmenticons}}
                                <div class="enrolmenticon">
                                    {{{.}}}
                                </div>
                            {{/enrolmenticons}}
                        </div>
                    </div>
                {{/hasenrolicons}}
            {{/showcourseenrolicons}}
        </div>
    {{/showdetailsbar}}


    {{! The card's footer: the first teacher with their name, the others behind "+N" (a list that
        opens on it, their names also as its tooltip), and a round arrow to the course. }}
    <div class="course-card-teacher-footer">
        {{#showcoursecontacts}}
            {{#hascontacts}}
                <div class="course-card-contacts">
                    {{#displaycontacts}}
                        {{#canviewuserdetails}}
                            <a href="{{config.wwwroot}}/user/profile.php?id={{{id}}}" class="course-card-contact" tabindex="-1">
                        {{/canviewuserdetails}}
                        {{^canviewuserdetails}}
                            <span class="course-card-contact">
                        {{/canviewuserdetails}}
                        <img src="{{{userpicture}}}" class="course-card-contact-avatar rounded-circle" alt="">
                        <span class="course-card-contact-name">{{contactname}}</span>
                        {{#canviewuserdetails}}
                            </a>
                        {{/canviewuserdetails}}
                        {{^canviewuserdetails}}
                            </span>
                        {{/canviewuserdetails}}
                    {{/displaycontacts}}

                    {{#hasadditionalcontacts}}
                        <span class="course-card-contact-extra" data-course-contact-extra>
                            <button type="button" class="course-card-contact-more" aria-expanded="false"
                                    title="{{remainingcontactnames}}">+{{additionalcontactcount}}</button>
                            <span class="course-card-contact-extra-list" aria-hidden="true">
                                {{#remainingcontacts}}
                                    {{#canviewuserdetails}}
                                        <a href="{{config.wwwroot}}/user/profile.php?id={{{id}}}" class="course-card-contact" tabindex="-1">
                                    {{/canviewuserdetails}}
                                    {{^canviewuserdetails}}
                                        <span class="course-card-contact">
                                    {{/canviewuserdetails}}
                                    <img src="{{{userpicture}}}" class="course-card-contact-avatar rounded-circle" alt="">
                                    <span class="course-card-contact-name">{{contactname}}</span>
                                    {{#canviewuserdetails}}
                                        </a>
                                    {{/canviewuserdetails}}
                                    {{^canviewuserdetails}}
                                        </span>
                                    {{/canviewuserdetails}}
                                {{/remainingcontacts}}
                            </span>
                        </span>
                    {{/hasadditionalcontacts}}
                </div>
            {{/hascontacts}}
        {{/showcoursecontacts}}
        <a href="{{viewurl}}" class="course-card-go" tabindex="-1" aria-hidden="true"></a>
    </div>

</div>

{{#js}}
(() => {
    const card = document.querySelector('[data-course-id="{{id}}"]');
    if (!card) {
        return;
    }

    // Teacher avatar expansion.
    const extra = card.querySelector('[data-course-contact-extra]');
    if (extra && !extra.dataset.initialized) {
        extra.dataset.initialized = '1';

        const button = extra.querySelector('.course-card-contact-more');
        const list = extra.querySelector('.course-card-contact-extra-list');

        const show = (open) => {
            extra.classList.toggle('is-open', open);
            button.setAttribute('aria-expanded', open ? 'true' : 'false');
            list.setAttribute('aria-hidden', open ? 'false' : 'true');
        };
        button.addEventListener('click', () => {
            show(!extra.classList.contains('is-open'));
        });
        // Closed again by a click anywhere else, or by Escape.
        document.addEventListener('click', (e) => {
            if (extra.classList.contains('is-open') && !extra.contains(e.target)) {
                show(false);
            }
        });
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && extra.classList.contains('is-open')) {
                show(false);
                button.focus();
            }
        });
    }

    // Course summary expansion.
    const summary = card.querySelector('[data-course-summary]');
    if (summary && !summary.dataset.initialized) {
        summary.dataset.initialized = '1';

        const content = summary.querySelector('[data-course-summary-content]');
        const toggle = summary.querySelector('[data-course-summary-toggle]');

        requestAnimationFrame(() => {
            const collapsedHeight = content.clientHeight;
            const fullHeight = content.scrollHeight;

            if (fullHeight <= collapsedHeight + 2) {
                summary.classList.add('has-no-overflow');
                return;
            }

            summary.classList.add('has-overflow');

            toggle.addEventListener('click', () => {
                const open = summary.classList.toggle('is-open');

                content.style.maxHeight = open
                    ? `${content.scrollHeight}px`
                    : '';

                toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
            });
        });
    }
})();
{{/js}}
