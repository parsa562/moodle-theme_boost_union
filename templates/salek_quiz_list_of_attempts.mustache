{{!
    @template theme_boost_union/salek_quiz_list_of_attempts

    Salek: the list of the attempts on the quiz's page (as mod_quiz/list_of_attempts), a card for
    each: its name and its review link on a line, its summary (theme_boost_union/salek_quiz_attempt_summary)
    under them (from theme_boost_union\output\mod_quiz_renderer).

    Example context (json):
    {
        "attempts": [
            {
                "name": "Attempt 1",
                "summary": "<table class=\"salek-quiz-summary\"></table>",
                "reviewlink": "<a href=\"#\">Review</a>"
            }
        ]
    }
}}
<h3>{{# str}}summaryofattempts, quiz{{/str}}</h3>

<ul class="list-unstyled salek-quiz-attempts">
{{#attempts}}
    <li class="salek-quiz-attempt">
        <div class="salek-quiz-attempt-head">
            <h4 class="salek-quiz-attempt-name">{{name}}</h4>
            {{#reviewlink}}<div class="salek-quiz-attempt-review">{{{reviewlink}}}</div>{{/reviewlink}}
        </div>
        {{{summary}}}
    </li>
{{/attempts}}
</ul>
